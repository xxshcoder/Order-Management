# Copy to .env (git-ignored) before running `docker compose up`.
# All values below are DEVELOPMENT ONLY. Generate real secrets for any shared environment.

# JWT (HS256). Must be at least 32 bytes for dev; use 64+ random bytes in real environments.
JWT_SECRET=dev-only-secret-change-me-please-32-bytes-minimum
JWT_ISSUER=order-platform
JWT_EXPIRATION_MINUTES=60

# Seeded demo users (created by the gateway auth module)
CUSTOMER_PASSWORD=customer123
ADMIN_PASSWORD=admin123

# Orders database
POSTGRES_ORDERS_DB=orders
POSTGRES_ORDERS_USER=orderuser
POSTGRES_ORDERS_PASSWORD=orderpass

# Stock database
POSTGRES_STOCK_DB=stock
POSTGRES_STOCK_USER=stockuser
POSTGRES_STOCK_PASSWORD=stockpass

# Infrastructure
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Correlation
APP_CORRELATION_HEADER=X-Correlation-Id

# Gateway rate limiting (requests / seconds / burst)
GATEWAY_RATE_LIMIT_REPLENISH=20
GATEWAY_RATE_LIMIT_BURST=40

# Observability
GRAFANA_ADMIN_PASSWORD=admin
